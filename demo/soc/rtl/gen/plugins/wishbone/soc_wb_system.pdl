# op 0b01 read / 0b10 write; st 0b00 ok, 0b01 busy, 0b10 err (sticky).

iProcsForModule soc_wb_system

iProc dbg_write { addr data } {
	iWrite dbg_op 0b10
	iWrite dbg_adr $addr
	iWrite dbg_dat $data
	iApply
	iRunLoop 16 -tck
	iWrite dbg_op 0b00
	iRead  dbg_st 0b00
	iApply
}

iProc dbg_read { addr data } {
	iWrite dbg_op 0b01
	iWrite dbg_adr $addr
