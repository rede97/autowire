# Generated by autowire plugin wishbone (PDL soc_wb_bus_cfg). Do not edit.
# op 0b01 read / 0b10 write; st 0b00 ok, 0b01 busy, 0b10 err (sticky).
# Level-0 static checks, NOT busy polling. Configure idle for worst-case latency.
# Busy or err fails the comparison; read data is an expected value.
# Dynamic hosts need bounded polling and error handling. Do not blindly relaunch.

iProcsForModule soc_wb_bus_cfg

iProc dbg_write { addr data } {
	iWrite dbg_op 0b10
	iWrite dbg_adr $addr
	iWrite dbg_dat $data
	iApply
	iRunLoop 16 -tck
	iWrite dbg_op 0b00
	iRead  dbg_st 0b00
	iApply
}

iProc dbg_read { addr data } {
	iWrite dbg_op 0b01
	iWrite dbg_adr $addr
	iWrite dbg_dat 0
	iApply
	iRunLoop 16 -tck
	iWrite dbg_op 0b00
	iRead  dbg_st 0b00
	iRead  dbg_dat $data
	iApply
}
