#!/bin/bash
# Mock bsub: strips LSF flags up to the command, logs the full argv to
# $DTSIM_MOCK_LAUNCH_LOG when set, and runs the wrapped command.
if [ -n "${DTSIM_MOCK_LAUNCH_LOG:-}" ]; then echo "bsub $*" >> "$DTSIM_MOCK_LAUNCH_LOG"; fi
while [ $# -gt 0 ]; do
  case "$1" in
    -I|-Is|-K) shift ;;
    -*) shift 2 ;;
    *) break ;;
  esac
done
if [ $# -eq 0 ]; then echo "mock bsub: nothing to run" >&2; exit 1; fi
exec "$@"
