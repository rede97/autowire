#!/bin/bash
# Mock VCS compiler: writes vcs.log and a simv script (-o, default ./simv),
# honors failure switches, and records its cwd and -f filelists.
VCS_LOG="vcs.log"
CM_DIR=""
SIMV="./simv"
prev=""
for arg in "$@"; do
  case "$prev" in
    -l) VCS_LOG="$arg" ;;
    -cm_dir) CM_DIR="$arg" ;;
    -o) SIMV="$arg" ;;
  esac
  prev="$arg"
done
{
  echo "mock vcs: $*"
  echo "cwd=$PWD"
  echo "output_dir=${output_dir:-}"
  echo "BAR_CFG=${BAR_CFG:-}"
  echo "INPUT=${INPUT:-}"
  echo "SIM_TRACE=${SIM_TRACE:-}"
  echo "UNRELATED_SECRET=${UNRELATED_SECRET:-}"
  echo "LD_PRELOAD=${LD_PRELOAD:-}"
} > "$VCS_LOG"
if [ -n "$CM_DIR" ]; then
  mkdir -p "$CM_DIR/snps/coverage/db/testdata"
fi
if [ "${DTSIM_MOCK_VCS_FAIL:-0}" = "1" ]; then
  echo "Error-[COMPFAIL] mock compile failure" >> "$VCS_LOG"
  echo "mock vcs failed" >> "$VCS_LOG"
  exit 1
fi
cp "$(dirname "$0")/simv" "$SIMV"
chmod +x "$SIMV"
echo "mock vcs: compile finished" >> "$VCS_LOG"
exit 0
